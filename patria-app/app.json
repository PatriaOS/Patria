{
  "expo": {
    "name": "patria-app",
    "slug": "patria-app",
    "scheme": "patria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.patria.dev",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Patria can share new photos with your family while the app is open, if you turn that on.",
        "NSPhotoLibraryAddUsageDescription": "Patria does not save photos to your library."
      }
    },
    "android": {
      "package": "app.patria.dev",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Patria uses photos you pick to share with your family."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Patria can share new photos with your family while the app is open, if you turn that on.",
          "savePhotosPermission": "Patria does not save photos to your library.",
          "preventAutomaticLimitedAccessAlert": true
        }
      ],
      "expo-video",
      "expo-font"
    ]
  }
}
