# Copy to .env.e2e.local (gitignored). Used only by the e2e native build.
# Normal `npx expo start` still reads .env and the hosted test project.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Passwords and the local service role key belong in .e2e-secrets, never here.

# Fixed FAKE letter release public key (matches the local-only fake private key in .env.example).
EXPO_PUBLIC_LETTER_RELEASE_PUBLIC_KEY_HEX=03ca1057fffbed5969b9619fc60d57877b24f95dbeb0844593b417d3cdeeeedc56
